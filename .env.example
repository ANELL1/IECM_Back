NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:4200
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=3306
# Usar el nombre exacto de la base creada (puede distinguir mayúsculas).
DB_NAME=MonitorCapturaPrueba
DB_USER=iecm_app
DB_PASSWORD="contraseña"
# Para desarrollo local. Producción exige TLS y certificado válido.
DB_SSL=false
# DB_SSL_CA=/ruta/al/ca.pem
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_REQUEST_TIMEOUT_MS=15000
